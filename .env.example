# =================================================================
# Checkra — Environment Configuration (Vercel & Local)
# =================================================================

# -----------------------------------------------------------------
# 1. AI Provider Selection (Dual Provider Architecture)
# -----------------------------------------------------------------
# Choose the active AI provider: "ollama" (for Local Dev) or "gemini" (for Vercel Production).
# If omitted: defaults to "gemini" on Vercel and "ollama" locally.
AI_PROVIDER=ollama

# --- A. Local Development (Ollama + Qwen3 1.7B) ---
# Ensure Ollama is running locally: `ollama run qwen3:1.7b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# --- B. Production (Google Gemini API via @google/genai) ---
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Set GEMINI_API_KEY in Vercel project environment variables (never commit).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 2. Production Web Search Provider (Optional)
# -----------------------------------------------------------------
# Checkra uses an intelligent fallback search architecture:
# 1. Gemini Google Search Grounding (when configured with GEMINI_API_KEY)
# 2. Configured external search provider (SearXNG / Custom Search API)
# 3. Public Web Search fallback (Wikipedia Open Search)
# 4. Safe offline Local Comparison against reference corpus
#
# If deploying a separate containerized SearXNG instance, specify its URL here:
# (Leave SEARCH_API_URL blank in production if you do not host a SearXNG instance)
SEARCH_ENGINE=searxng
SEARCH_API_URL=
SEARCH_API_KEY=

# -----------------------------------------------------------------
# 3. External Grammar Engine (Optional)
# -----------------------------------------------------------------
# Checkra includes a built-in rule-based linguistic engine that operates
# with zero external dependencies. Specify an external LanguageTool URL only if desired:
GRAMMAR_API_URL=
GRAMMAR_API_KEY=

# -----------------------------------------------------------------
# 4. Vector Embeddings for Semantic Matching (Optional)
# -----------------------------------------------------------------
# Checkra includes a deterministic mathematical cosine subword/stem vectorizer.
# Specify an external embedding endpoint only if you want remote vector inference:
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# -----------------------------------------------------------------
# 5. Local Development Server Port (Optional)
# -----------------------------------------------------------------
# Only used when running locally via `npm start` or `node server/server.js`.
# Ignored in Vercel serverless environment.
PORT=8787

# -----------------------------------------------------------------
# 6. Search & Extraction Limits (Optional)
# -----------------------------------------------------------------
MAX_SEARCH_QUERIES=8
MAX_SOURCES=20
