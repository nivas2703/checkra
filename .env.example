# =================================================================
# Checkra — Environment Configuration
# =================================================================

# Server Port
PORT=8787

# Google Gemini AI Integration
# Required for Gemini Search Grounding, AI Evidence Review, and AI Rewrite
# Obtain a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Web Search Provider (SearXNG or JSON Search Engine)
# Local development default: http://localhost:8080/search
# Production requires a hosted/containerized SearXNG deployment
SEARCH_ENGINE=searxng
SEARCH_API_URL=http://localhost:8080/search
SEARCH_API_KEY=

# Grammar & Linguistic Provider (Optional)
# Leave blank to use Checkra's built-in rule-based linguistic engine
GRAMMAR_API_URL=
GRAMMAR_API_KEY=

# Vector Embeddings for Semantic Matching (Optional)
# Leave blank to use Checkra's deterministic mathematical cosine vectorizer
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Fallback LLM Provider (Optional)
# For OpenAI-compatible completion endpoints
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Execution & Processing Limits
MAX_SEARCH_QUERIES=8
MAX_SOURCES=20
MAX_DOCUMENT_SIZE_MB=20
REQUEST_TIMEOUT_MS=15000
